__pycache__/
.venv/
.DS_Store
.omc

# Only the finished paper is distributed; its source, its figures and the
# LaTeX build artefacts are not.
manuscript/*
!manuscript/paper.pdf

# Computed output. Every figure and table can be regenerated from the code;
# shipping the caches would only make the repository heavy and let a stale
# .npz masquerade as a fresh result.
results/
logs/

# personal working notes, not part of the submission
Q-SITE-2026-info.md

# The notebook writes here too; only the paper is distributed, so a reduced
# notebook run can never reach the repository. It can still clobber a local
# figure, which is why every run script takes --plot-only.
